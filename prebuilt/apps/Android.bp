//
// Prebuilt apps for fork lineage
//

// Droid-ify to provide F-Droid
android_app_import {
    name: "Droid-ify",
    apk: "com.looker.droidify.apk",
    presigned: true,
    preprocessed: true,
    dex_preopt: {
        enabled: false,
    },
}

// Aurora Store to provide GPlay
android_app_import {
    name: "AuroraStore",
    apk: "com.aurora.store.apk",
    presigned: true,
    preprocessed: true,
    extract_jni: true,
    dex_preopt: {
        enabled: false,
    },
}